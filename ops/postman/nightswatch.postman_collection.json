    {
      "name": "4 \u00b7 Fire an alert (signed webhook)",
      "item": [
        {
          "name": "Alertmanager webhook (HMAC-signed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/webhooks/alertmanager/{{tenant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "webhooks",
                "alertmanager",
                "{{tenant_id}}"
              ]
            },
            "description": "No bearer auth \u2014 authenticated by HMAC over the body using the tenant's webhook signing secret (computed in the pre-request script). 202 = alert persisted + investigation enqueued. Re-sending within 15 min dedupes onto the same investigation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"{}:{alertname=\\\"HighErrorRate\\\"}\",\n  \"status\": \"firing\",\n  \"receiver\": \"ai-sre\",\n  \"groupLabels\": {\n    \"alertname\": \"HighErrorRate\"\n  },\n  \"commonLabels\": {\n    \"alertname\": \"HighErrorRate\",\n    \"service\": \"checkout\",\n    \"severity\": \"critical\"\n  },\n  \"commonAnnotations\": {\n    \"summary\": \"Error rate above 5%\"\n  },\n  \"externalURL\": \"http://alertmanager.example\",\n  \"alerts\": [\n    {\n      \"status\": \"firing\",\n      \"labels\": {\n        \"alertname\": \"HighErrorRate\",\n        \"service\": \"checkout\",\n        \"severity\": \"critical\",\n        \"pod\": \"checkout-abc123\"\n      },\n      \"annotations\": {\n        \"summary\": \"Error rate above 5%\",\n        \"description\": \"5xx ratio exceeded threshold for 10m\"\n      },\n      \"startsAt\": \"{{$isoTimestamp}}\",\n      \"generatorURL\": \"http://prometheus.example/graph\"\n    }\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sign the (variable-resolved) raw body exactly as Alertmanager's",
                  "// forwarder would: X-AI-SRE-Signature: sha256=<hmac-sha256-hex>.",
                  "const secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "const raw = pm.variables.replaceIn(pm.request.body.raw);",
                  "const sig = 'sha256=' + CryptoJS.HmacSHA256(raw, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({key: 'X-AI-SRE-Signature', value: sig});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 accepted\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        }
      ]
    },
