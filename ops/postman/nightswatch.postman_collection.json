    {
      "name": "8 \u00b7 Backtest & replay",
      "item": [
        {
          "name": "Backtest (dry run \u2014 no Slack post)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/investigations/backtest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "investigations",
                "backtest"
              ]
            },
            "description": "Runs the pipeline on a submitted payload without dedupe; dry_run suppresses delivery.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alert_payload\": {\n    \"version\": \"4\",\n    \"groupKey\": \"{}:{alertname=\\\"HighErrorRate\\\"}\",\n    \"status\": \"firing\",\n    \"receiver\": \"ai-sre\",\n    \"groupLabels\": {\n      \"alertname\": \"HighErrorRate\"\n    },\n    \"commonLabels\": {\n      \"alertname\": \"HighErrorRate\",\n      \"service\": \"checkout\",\n      \"severity\": \"critical\"\n    },\n    \"commonAnnotations\": {\n      \"summary\": \"Error rate above 5%\"\n    },\n    \"externalURL\": \"http://alertmanager.example\",\n    \"alerts\": [\n      {\n        \"status\": \"firing\",\n        \"labels\": {\n          \"alertname\": \"HighErrorRate\",\n          \"service\": \"checkout\",\n          \"severity\": \"critical\",\n          \"pod\": \"checkout-abc123\"\n        },\n        \"annotations\": {\n          \"summary\": \"Error rate above 5%\",\n          \"description\": \"5xx ratio exceeded threshold for 10m\"\n        },\n        \"startsAt\": \"{{$isoTimestamp}}\",\n        \"generatorURL\": \"http://prometheus.example/graph\"\n      }\n    ]\n  },\n  \"service_id\": \"{{service_id}}\",\n  \"dry_run\": true\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('investigation_id', data.investigation_id || data.id);",
                  "pm.test(\"201 created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay an investigation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/investigations/{{investigation_id}}/replay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "investigations",
                "{{investigation_id}}",
                "replay"
              ]
            },
            "description": "Re-executes the live pipeline against current data; new investigation links back via replayed_from."
          },
          "response": []
        }
      ]
